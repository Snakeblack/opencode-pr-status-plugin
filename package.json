{
  "name": "opencode-pr-status-plugin",
  "version": "0.1.0",
  "description": "OpenCode V2 sidebar panel showing your open pull requests and their aggregated CI state, read through the local gh CLI.",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test scripts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snakeblack/opencode-pr-status-plugin.git"
  },
  "homepage": "https://github.com/Snakeblack/opencode-pr-status-plugin#readme",
  "bugs": {
    "url": "https://github.com/Snakeblack/opencode-pr-status-plugin/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opentui",
    "tui",
    "pull-requests",
    "ci",
    "gh"
  ],
  "author": "Snakeblack",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@opencode/plugin": "^2.0.32"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@opencode/theme": "^2.0.32",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "@types/node": "^26.6.5",
    "solid-js": "^1.9.12",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
